# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — SERVER ONLY. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Site ────────────────────────────────────────────────────────────────────
# Public base URL used for OG tags, Paystack callbacks, share links, etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Payments (Paystack) ─────────────────────────────────────────────────────
# Secret key — SERVER ONLY. Used for checkout init, transfers, and webhook
# signature verification.
PAYSTACK_SECRET_KEY=sk_test_xxx

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx

# ─── Background jobs (Upstash QStash) ────────────────────────────────────────
# Signing keys used to verify inbound QStash webhook requests (crons, watermark
# queue). Required for the payout/clearance/watermark routes in production.
QSTASH_CURRENT_SIGNING_KEY=sig_xxx
QSTASH_NEXT_SIGNING_KEY=sig_xxx

# ─── Cron / internal auth ────────────────────────────────────────────────────
# Shared secret for internal-to-internal calls (e.g. the watermark worker).
# MUST be set in production — the code fails closed if it is missing.
CRON_SECRET=generate-a-long-random-string

# ─── Media processing (optional) ─────────────────────────────────────────────
# Override the ffmpeg binary path if not using ffmpeg-static.
# FFMPEG_PATH=/usr/bin/ffmpeg
